TELEGRAM_TOKEN=replace_with_your_bot_token
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the server-only service_role key; never expose it in the Mini App.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# The Supabase project URL, without the function path.
PRODUCTION_URL=https://your-project-ref.supabase.co
TELEGRAM_WEBHOOK_PATH=/functions/v1/telegram-webhook
# Use a high-entropy value and configure the same secret in Supabase.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
PORT=3000
